# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
pytest-of-*/
# Scratch directories left in the repo root by test runs and repro scripts.
# They can hold a generated credentials file, so they must never be staged.
tmp*/

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
.serena/
.claude/
*.swp
*.swo
*~

# Project specific
config/credentials.enc
config/.salt
# The sidecar the credential store locks while it rewrites credentials.enc. It appears
# on the first change a real install makes, and it belongs to that machine.
config/*.lock
config/api.yaml
config/.api_salt
users/
*.log

# Environment variables
.env
.env.local
.env.*.local

# Secrets - NEVER commit these
*.pem
*.key
secrets/
nul
.claude-flow/
