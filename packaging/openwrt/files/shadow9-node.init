#!/bin/sh /etc/rc.common

# Refreshes the tunnel at boot. Not a daemon: it runs once and writes nothing
# when the hub's topology revision has not changed.
#
# START=95 puts it after network and firewall, so uci commit and the reloads
# below act on services that are already up.

START=95
USE_PROCD=1

start_service() {
	local enabled

	config_load shadow9
	config_get_bool enabled node enabled 1

	[ "$enabled" = 1 ] || return 0
	/usr/sbin/shadow9-node refresh
}

stop_service() {
	# Deliberately empty. The tunnel is UCI configuration, not a process, and
	# tearing it down on "service stop" would drop the operator's own way in.
	return 0
}
