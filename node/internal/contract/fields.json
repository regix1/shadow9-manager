    "fields": [
      { "name": "address", "type": "string", "required": true },
      { "name": "hub_public_key", "type": "string", "required": true },
      { "name": "hub_endpoint", "type": "string", "required": true },
      { "name": "tunnel_network", "type": "string", "required": true },
